ct": 1}], "_data": [{"type": "question", "contents": [{"type": "text", "content": "<span class=\"run-on-question\"></span> "}, {"type": "audio", "content": "enpe8n4le03ob03re6aud07"}, {"type": "text", "content": "The"}]}, {"type": "post_question", "contents": {"type": "", "content": "are useful to manage the "}}, {"type": "objective", "content": "secondary_1"}], "id": 4}, {"responses": [{"selected": 0, "id": 0, "_data": [{"type": "text", "content": ""}], "correct": 0}, {"selected": 0, "id": 1, "_data": [{"type": "text", "content": "hardware "}], "correct": 1}], "_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}, {"type": "post_question", "contents": {"type": "", "content": "resources of a computer."}}, {"type": "objective", "content": "secondary_1"}], "id": 5}], "template_override": 2}, {"type": "RSLT", "stimuli_ids": [], "id": 11, "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "allowed_attempts": 2}}], "questions": [{"responses": [{"selected": 0, "id": 0, "_data": [{"type": "text", "content": ""}], "correct": 0}, {"selected": 0, "id": 1, "_data": [{"type": "text", "content": ""}], "correct": 1}], "_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}], "id": 0}], "template_override": 1}, {"type": "DWS", "stimuli_ids": [], "id": 12, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " What were you doing while you were using the information system? "}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "allowed_attempts": 2}}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment."}]}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}], "questions": [{"responses": [{"selected": 0, "id": 0, "_data": [{"type": "text", "content": ""}], "correct": 1}], "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "enpe8n4le03ob03re7pdf01.pdf"}]}], "id": 0}], "template_override": 1}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "_data": [], "template_override": 1, "id": 0}, {"type": "audio", "contents": [{"value": {"coverimg": "enpe8n4le03ob03re2img01.jpg", "images": [{"text": "<strong>Anderson</strong>: We were working really hard this time a month ago on a new information system, remember?</br>\n<strong>John</strong>: Yeah. I remember that while I was working with the technical staff on installing the networks, you and the other testers were checking the printers and computers' functioning. Once you finished, Caroline and Isabella, our programmers, were writing codes and instructions to customize the mainframes, laptops, and desktops.</br>\n<strong>Anderson</strong>: Uh-huh. At 6 pm that day, I recall that Caroline was doing the programming of most computers when Jack, the systems analyst, told her to stop all her work. This happened because all of a sudden the client changed the requirements and everything would need to be redone.", "image": "enpe8n4le03ob03re2img01.jpg", "time": "100", "id": 0}, {"text": "<strong>John</strong>: Ohh yeah! But, why was she doing the wrong things during the installation process? She was almost finishing her work when she was told to stop it. </br>\n<strong>Anderson</strong>: As far as I know, the mistake was so big that the chief information officer terminated Jack's contract after investigating that the failure happened because of him and not the client's.</br>\n<strong>John</strong>: Poor Jack.</br>\n<strong>Anderson</strong>: I know, right? You know what I liked about that project, its software resources. The multi-user and multitasking operating systems controlling the mainframes were amazing. Besides, most of the desktops and laptops needed special application software packages to be installed for the huge number of transactions that the company handles. I learned a lot from that project.", "image": "enpe8n4le03ob03re2img02.jpg", "time": "44500", "id": 1}, {"text": "<strong>John</strong>: Well, what I liked the most was all the hardware we installed. I really enjoy my job when there are a lot of technological resources involved.  For example, resources like laser printers, photocopiers, laptops, desktops, mainframes, routers, scanners, LED TVs, video screens, wireless projector screens, overhead projectors, and interactive whiteboards. Even smartphones! I remember that while I was helping to install software in several notebooks, some people asked me to sync their smartphones with their office PCs.", "image": "enpe8n4le03ob03re2img03.jpg", "time": "93000", "id": 2}], "audiosrc": "enpe8n4le03ob03re2aud01"}, "type": "slideshow"}], "title": "", "id": 1, "template_override": 1, "_data": []}], "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": ""}, {"type": "unit_name", "content": "Resources in Information Systems"}, {"type": "position", "content": 3}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 3}, {"type": "level", "content": "A2.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you hear/use to talk about information systems resources."}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Identify key information about people's jobs and places of work in spoken or written contexts.  Design the data structure, starting from the conceptual model determined in the systems analysis, using database IT tools, according to regulation and established standards."}, {"type": "secondary_1", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.  Recognizes simple ideas on the design of an information system, computer architecture and hardware, and basic concepts on graphic design."}]}, {"type": "background_image", "content": "enpe8n4le03ob03re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Time expressions in past continuous in affirmative, negative and questions"}, {"type": "describer", "content": "The <span class=\"strong\">Past Continuous tense</span> has several uses, but generally speaking, it refers to actions that were happening for some time in the past and then finished."}, {"type": "text", "content": "<p><strong>Functions</strong></p> <p>The <strong>past continuous</strong> tense is used to explain:</p> <ul> <li>an action happening at a specific point of time in the past.</li> <li>an action that was happening during some time in the past.</li> <li>an action that was happening when something important took place.</li> </ul> <p><strong>Time expressions in the Past Continuous</strong> <strong>tense</strong>&nbsp;&nbsp;</p> <p>There are many <i>time expressions</i> associated to the <strong>past continuous</strong> tense. Depending on the function, a <i>time expression</i> is more suitable than other. Let&rsquo;s take a look at some of these time expressions:</p> <ul> <li><i>As &hellip;., &hellip;..</i></li> <li><i>While &hellip;., &hellip;.</i></li> <li><i>This time yesterday, this time last year, etc.</i></li> <li><i>All last night, all last week, all last month, etc. </i></li> <li><i>Between &hellip; and &hellip; yesterday, between &hellip; and &hellip; last year, etc.</i></li> <li><i>At noon yesterday, at midnight the day before yesterday, etc.</i></li> <li><i>During the whole night, during the break time, etc.</i></li> <li><i>&hellip;. when &hellip;.</i></li> </ul> <p>Examples:</p> <ul> <li><strong><i>As</i></strong><i> Kathie <strong>was testing</strong> the software, I <strong>was reviewing</strong> the protocol to install the network system.</i></li> <li><strong><i>While</i></strong><i> Kathie <strong>was testing</strong> the software, I <strong>was reviewing</strong> the protocol to install the network system.</i></li> <li><i>We <strong>were setting up</strong> the office equipment, notebooks, printers and projectors <strong>all last night.</strong> </i></li> <li><strong><i>Between 9 am and 10 pm yesterday,</i></strong><i> we <strong>were working</strong> on programming the new desktops and notebooks that came to the company.</i></li> <li><i>Sandy <strong>was installing</strong> the communications network <strong>when</strong> suddenly a short circuit happened in one of the modules she <strong>was working on</strong> during the whole morning. &nbsp;</i></li> </ul>"}, {"type": "example", "content": "We were working really hard this time a month ago on a new information system, remember?"}, {"type": "example", "content": "I remember that while I was working with the technical staff on installing the networks, you and the other testers were checking the printers and computers' functioning.Caroline was doing the programming of most computers when Jack, the systems analyst, told her to stop all her work."}, {"type": "example", "content": "Caroline was doing the programming of most computers when Jack, the systems analyst, told her to stop all her work."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Computer metaphors"}, {"type": "describer", "content": "In the world of computers, there are some singular words which they may seem like any other but, in fact, they have different meanings.  "}, {"type": "text", "content": " <p><strong>Bus:</strong> Like a passenger bus, a databus is a tool that helps data to travel every day by going and coming back to the same point. A databus uses a circuitry similar to a bus that helps people to commute.</p> <p><strong>Window:</strong> Just like when you see the world through a room&rsquo;s window, a program window let users see what&rsquo;s going on in that program.&nbsp;</p> <p><strong>Frame:</strong> Like a photograph camera, frames compartmentalize screen space and help to individualize space and concepts.&nbsp;</p> <p><strong>Desktop:</strong> A visual surface can be similar to a panoramic. It is a generic physical surface where the most important elements are found.</p> <p><strong>Open/Close:</strong> Program windows, the programs themselves and ports need to be opened or closed to reach a particular goal.&nbsp;</p> <p><strong>File:</strong> Data occupies space and a useful way to pack it is in a file. Such data can be modified, stored, or retrieve.&nbsp;</p> <p><strong>Folder:</strong> A folder is a cluster of files of the same or different types.</p> <p>&nbsp;</p>"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "technical staff  "}, {"type": "definition", "content": "employees that are able to apply scientific knowledge to repair, maintain, install, program, or modify machines and equipment"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I remember that while I was working with the technical staff on installing the networks, you and the other testers were checking the printers and computers' functioning. "}, {"type": "audio", "content": "enpe8n4le03ob03aud01"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "testers "}, {"type": "definition", "content": "employees in an IT department in charge of checking software and hardware's functioning "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I remember that while I was working with the technical staff on installing the networks, you and the other testers were checking the printers and computers' functioning."}, {"type": "audio", "content": "enpe8n4le03ob03aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "recall "}, {"type": "definition", "content": "to remember "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: At 6 pm that day, I recall Caroline was doing the programming of most computers, when Jack, the systems analyst, told her to stop all her work."}, {"type": "audio", "content": "enpe8n4le03ob03aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "redo "}, {"type": "definition", "content": "to do again, to start again"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: At 6 pm that day, I recall Caroline was doing the programming of most computers, when Jack, the systems analyst, told her to stop all her work because of a sudden change in the client's requirements and everything would need to be redone."}, {"type": "audio", "content": "enpe8n4le03ob03aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "interactive whiteboard "}, {"type": "definition", "content": "an interactive screen connected to a computer "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I really enjoy when there are a lot of technological resources involved, for example, laser printers, photocopiers, laptops, desktops, mainframes, routers, scanners, LED TVs, video screens, wireless projector screens, overhead projectors and interactive whiteboards."}, {"type": "audio", "content": "enpe8n4le03ob03aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "notebook  "}, {"type": "definition", "content": "a notebook is another name given to a laptop"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Even smartphones. I remember that while I was helping to install software in some notebooks, some people asked me to synch their smartphones with their office PCs."}, {"type": "audio", "content": "enpe8n4le03ob03aud06"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Search for experiences people had while using information systems. "}, {"type": "text", "content": "Based on those, think about experiences that happened to you while you were using an information system. "}, {"type": "text", "content": "Write down a paragraph about your experience(s). "}, {"type": "text", "content": "Share your paragraph with the class and discuss. "}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I search for experiences people had while using information systems."}, {"type": "text", "content": "I think about experiences that happened to me while I was using an information system."}, {"type": "text", "content": "I write down a paragraph about my experience(s). "}, {"type": "text", "content": "I share and discuss information related to experiences with information systems"}]}]}